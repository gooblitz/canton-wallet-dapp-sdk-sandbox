VITE_NETWORK=devnet
VITE_WALLET_RPC_URL=
VITE_WALLET_RPC_URLS_JSON=
VITE_WALLET_DOMAIN=
VITE_REGISTRY_DOMAIN=https://sp-lat-dn.cddev.site
# Legacy alias still supported:
# VITE_DEVNET_REGISTRY_DOMAIN=
VITE_REGISTRY_API_KEY=
VITE_REGISTRY_URLS_JSON=
VITE_TOKEN_REGISTRY_URLS_JSON=
VITE_TOKEN_REGISTRY_URL=/api/registry-proxy
VITE_SCAN_URL=/api/registry-proxy

# Optional TestNet profile values.
VITE_TESTNET_WALLET_RPC_URL=https://lat-tn.cddev.site/api/v1/dapp
VITE_TESTNET_WALLET_DOMAIN=https://lat-tn.cddev.site
VITE_TESTNET_REGISTRY_DOMAIN=https://sp-lat-tn.cddev.site
VITE_TESTNET_REGISTRY_URL=/api/registry-proxy/testnet
VITE_TESTNET_SCAN_URL=/api/registry-proxy/testnet
VITE_TESTNET_USDCX_REGISTRY_URL=
VITE_HOLDINGS_DIAGNOSTICS=false

# Vite dev proxy target for /api/registry-proxy -> /v0/scan-proxy/*
SCAN_PROXY_BACKEND_URL=https://sp-lat-dn.cddev.site
TESTNET_SCAN_PROXY_BACKEND_URL=https://sp-lat-tn.cddev.site
# Optional upstream auth header injected by Vite proxy:
# SCAN_PROXY_UPSTREAM_AUTH=Bearer <token>

# Vite dev proxy targets for /api/token-standard/<network>/*
UTILITIES_TOKEN_STANDARD_DEVNET_URL=https://api.utilities.digitalasset-dev.com/api/token-standard/v0
UTILITIES_TOKEN_STANDARD_TESTNET_URL=https://api.utilities.digitalasset-staging.com/api/token-standard/v0
UTILITIES_TOKEN_STANDARD_MAINNET_URL=https://api.utilities.digitalasset.com/api/token-standard/v0

# Reference endpoint for global utilities instrument configuration discovery.
UTILITIES_INSTRUMENT_CONFIG_TESTNET_URL=https://api.utilities.digitalasset-staging.com/api/utilities/v0/contract/instrument-configuration/all
